{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XallorRemote",
  "version": "0.1.0",
  "identifier": "com.xallorremote.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XallorRemote",
        "width": 980,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
